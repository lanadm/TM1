#==================================
SKIPCHECK;
#==================================

#Plug 3205_Adj
          #  Note: When we switched over to FY24 in D365_GL, there was a retained earnings account that did not get picked up by IPA because the cost center was empty. This is causing 
          #  an ongoing out of balance with the beginning balance rollover in D365. For this reason an adjustment account was created (3205_Adj) to adjust out the -429.36 difference to account for this. 
          #  the amount was manually adjusted out in FY24, and is being plugged into the Beginning balance each year beginning in FY25.


['3205_Adj', '52509999', D365_Project:'000', D365_Product:'00', 'Actual', 'Beginning'] = N: IF( DB( '}ElementAttributes_YEAR', !YEAR, '3205_Adj_Rule' ) @<> 'N', -429.36, STET );



#Balance Sheet YTD Calculations

['OCT YTD'] = C: IF( DB( '}ElementAttributes_D365_MainAcct', !D365_MainAcct, 'BalAcct' ) @= 'BAL' &
			              DB( '}ElementAttributes_D365_Category', !D365_Category, 'BAL' ) @= 'Y' &
			              DB( '}ElementAttributes_YEAR', !YEAR, 'Historical' ) @= 'N',
			              ['OCT'],
			              CONTINUE );

['NOV YTD'] = C: IF( DB( '}ElementAttributes_D365_MainAcct', !D365_MainAcct, 'BalAcct' ) @= 'BAL' &
			              DB( '}ElementAttributes_D365_Category', !D365_Category, 'BAL' ) @= 'Y' &
			              DB( '}ElementAttributes_YEAR', !YEAR, 'Historical' ) @= 'N',
			              ['NOV'],
			              CONTINUE );

['DEC YTD'] = C: IF( DB( '}ElementAttributes_D365_MainAcct', !D365_MainAcct, 'BalAcct' ) @= 'BAL' &
			              DB( '}ElementAttributes_D365_Category', !D365_Category, 'BAL' ) @= 'Y' &
			              DB( '}ElementAttributes_YEAR', !YEAR, 'Historical' ) @= 'N',
			              ['DEC'],
			              CONTINUE );

['JAN YTD'] = C: IF( DB( '}ElementAttributes_D365_MainAcct', !D365_MainAcct, 'BalAcct' ) @= 'BAL' &
			              DB( '}ElementAttributes_D365_Category', !D365_Category, 'BAL' ) @= 'Y' &
			              DB( '}ElementAttributes_YEAR', !YEAR, 'Historical' ) @= 'N',
			              ['JAN'],
			              CONTINUE );

['FEB YTD'] = C: IF( DB( '}ElementAttributes_D365_MainAcct', !D365_MainAcct, 'BalAcct' ) @= 'BAL' &
			              DB( '}ElementAttributes_D365_Category', !D365_Category, 'BAL' ) @= 'Y' &
			              DB( '}ElementAttributes_YEAR', !YEAR, 'Historical' ) @= 'N',
			              ['FEB'],
			              CONTINUE );

['MAR YTD'] = C: IF( DB( '}ElementAttributes_D365_MainAcct', !D365_MainAcct, 'BalAcct' ) @= 'BAL' &
			              DB( '}ElementAttributes_D365_Category', !D365_Category, 'BAL' ) @= 'Y' &
			              DB( '}ElementAttributes_YEAR', !YEAR, 'Historical' ) @= 'N',
			              ['MAR'],
			              CONTINUE );

['APR YTD'] = C: IF( DB( '}ElementAttributes_D365_MainAcct', !D365_MainAcct, 'BalAcct' ) @= 'BAL' &
			              DB( '}ElementAttributes_D365_Category', !D365_Category, 'BAL' ) @= 'Y' &
			              DB( '}ElementAttributes_YEAR', !YEAR, 'Historical' ) @= 'N',
			              ['APR'],
			              CONTINUE );

['MAY YTD'] = C: IF( DB( '}ElementAttributes_D365_MainAcct', !D365_MainAcct, 'BalAcct' ) @= 'BAL' &
			              DB( '}ElementAttributes_D365_Category', !D365_Category, 'BAL' ) @= 'Y' &
			              DB( '}ElementAttributes_YEAR', !YEAR, 'Historical' ) @= 'N',
			              ['MAY'],
			              CONTINUE );

['JUN YTD'] = C: IF( DB( '}ElementAttributes_D365_MainAcct', !D365_MainAcct, 'BalAcct' ) @= 'BAL' &
			              DB( '}ElementAttributes_D365_Category', !D365_Category, 'BAL' ) @= 'Y' &
			              DB( '}ElementAttributes_YEAR', !YEAR, 'Historical' ) @= 'N',
			              ['JUN'],
			              CONTINUE );

['JUL YTD'] = C: IF( DB( '}ElementAttributes_D365_MainAcct', !D365_MainAcct, 'BalAcct' ) @= 'BAL' &
			              DB( '}ElementAttributes_D365_Category', !D365_Category, 'BAL' ) @= 'Y' &
			              DB( '}ElementAttributes_YEAR', !YEAR, 'Historical' ) @= 'N',
			              ['JUL'],
			              CONTINUE );

['AUG YTD'] = C: IF( DB( '}ElementAttributes_D365_MainAcct', !D365_MainAcct, 'BalAcct' ) @= 'BAL' &
			              DB( '}ElementAttributes_D365_Category', !D365_Category, 'BAL' ) @= 'Y' &
			              DB( '}ElementAttributes_YEAR', !YEAR, 'Historical' ) @= 'N',
			              ['AUG'],
			              CONTINUE );

['SEP YTD'] = C: IF( DB( '}ElementAttributes_D365_MainAcct', !D365_MainAcct, 'BalAcct' ) @= 'BAL' &
			              DB( '}ElementAttributes_D365_Category', !D365_Category, 'BAL' ) @= 'Y' &
			              DB( '}ElementAttributes_YEAR', !YEAR, 'Historical' ) @= 'N',
			              ['SEP'],
			              CONTINUE );


# CURRENT EARNINGS RULE

[{ 'Actual', 'Forecast 4', 'Forecast 5', 'Forecast 6', 'Forecast 7', 'Forecast 8', 'Forecast 9', 'Forecast 10', 'Budget', 'Budget 1', 'Budget 2', 'Budget 3', 'Budget 4', 'Budget 5', 'Rev Fcst' },'Current Earnings'] = ['NET INCOME'];



