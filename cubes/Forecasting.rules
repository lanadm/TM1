SKIPCHECK;

#====================
# Base Price
#====================

['Base Price'] = N: ['Base Gross'] \ ['CurrYear Quantity'];


#====================
# Price and Elasticity Factor 
#====================

#-----------------------------------------------------------------------------------------------------------------------
#Allow Input to SKU elements that will be propagated to other SKUs in the appropriate rollups
#-----------------------------------------------------------------------------------------------------------------------

# Half Ham Input SKU 101200
[{'Price Factor', 'Elasticity Factor'}, Lskus:'101200', 'Base Data'] = stet;

# Quarter Ham Input SKU 100114 
[{'Price Factor', 'Elasticity Factor'}, Lskus:'100114', 'Base Data'] = stet;

# Boneless Ham Input SKU 100105
[{'Price Factor', 'Elasticity Factor'}, Lskus:'100105', 'Base Data'] = stet;

# Carver Ham Input SKU 101215
[{'Price Factor', 'Elasticity Factor'}, Lskus:'101215', 'Base Data'] = stet;

# Whole Ham Input SKU 101000
[{'Price Factor', 'Elasticity Factor'}, Lskus:'101000', 'Base Data'] = stet;

# Turkey Breast Input SKU 110104 
[{'Price Factor', 'Elasticity Factor'}, Lskus:'110104', 'Base Data'] = stet;

#By-the-Slice Input SKU 101203 
[{'Price Factor', 'Elasticity Factor'}, Lskus:'101203', 'Base Data'] = stet;

#Whole Turkey Input SKU 110102  
[{'Price Factor', 'Elasticity Factor'}, Lskus:'110102', 'Base Data'] = stet;

#Sides Input SKU 140102 
[{'Price Factor', 'Elasticity Factor'}, Lskus:'140102', 'Base Data'] = stet;

#Dinners Input SKU 180799 
[{'Price Factor', 'Elasticity Factor'}, Lskus:'180799', 'Base Data'] = stet;

#BBQ Roast Input SKU 120000 
[{'Price Factor', 'Elasticity Factor'}, Lskus:'120000', 'Base Data'] = stet;

#Beef Input SKU 120165 
[{'Price Factor', 'Elasticity Factor'}, Lskus:'120165', 'Base Data'] = stet;

#BBQ Input SKU 120113 
[{'Price Factor', 'Elasticity Factor'}, Lskus:'120113', 'Base Data'] = stet;

#Bacon Input SKU 120115 
[{'Price Factor', 'Elasticity Factor'}, Lskus:'120115', 'Base Data'] = stet;

#Sandwiches Input SKU 180220 
[{'Price Factor', 'Elasticity Factor'}, Lskus:'180220', 'Base Data'] = stet;

#Lunch Soups Input SKU 185019 
[{'Price Factor', 'Elasticity Factor'}, Lskus:'185019', 'Base Data'] = stet;

#Lunch Main Salads Input SKU 181114 
[{'Price Factor', 'Elasticity Factor'}, Lskus:'181114', 'Base Data'] = stet;

#Lunch Addons Input SKU 180331 
[{'Price Factor', 'Elasticity Factor'}, Lskus:'180331', 'Base Data'] = stet;

#Appetizers Input SKU 130168 
[{'Price Factor', 'Elasticity Factor'}, Lskus:'130168', 'Base Data'] = stet;

#Breads Input SKU 170107 
[{'Price Factor', 'Elasticity Factor'}, Lskus:'170107', 'Base Data'] = stet;

#Desserts Input SKU 150128 
[{'Price Factor', 'Elasticity Factor'}, Lskus:'150128', 'Base Data'] = stet;

#Condiments Input SKU 160135 
[{'Price Factor', 'Elasticity Factor'}, Lskus:'160135', 'Base Data'] = stet;

#Sweets Input SKU 152236 
[{'Price Factor', 'Elasticity Factor'}, Lskus:'152236', 'Base Data'] = stet;

#Soups Input SKU 120139 
[{'Price Factor', 'Elasticity Factor'}, Lskus:'120139', 'Base Data'] = stet;

#Ham Bones Input SKU 120107 
[{'Price Factor', 'Elasticity Factor'}, Lskus:'120107', 'Base Data'] = stet;

#Beverages Input SKU 1035190 
[{'Price Factor', 'Elasticity Factor'}, Lskus:'1035190', 'Base Data'] = stet;

#Boxes Input SKU 200104 
[{'Price Factor', 'Elasticity Factor'}, Lskus:'200104', 'Base Data'] = stet;

#Breakfast Sandwiches Input SKU 185003 
[{'Price Factor', 'Elasticity Factor'}, Lskus:'185003', 'Base Data'] = stet;

#Breakfast Trays Input SKU 185010 
[{'Price Factor', 'Elasticity Factor'}, Lskus:'185010', 'Base Data'] = stet;

#Buffets Input SKU 180509 
[{'Price Factor', 'Elasticity Factor'}, Lskus:'180509', 'Base Data'] = stet;

#Retail Delivery Fees Input SKU 300098 
[{'Price Factor', 'Elasticity Factor'}, Lskus:'300098', 'Base Data'] = stet;

#Misc Excl Gratuity Input SKU 200200 
[{'Price Factor', 'Elasticity Factor'}, Lskus:'200200', 'Base Data'] = stet;

#Ham Bundles Input SKU 181283 
[{'Price Factor', 'Elasticity Factor'}, Lskus:'181283', 'Base Data'] = stet;

#Baskets Input SKU 001032 
[{'Price Factor', 'Elasticity Factor'}, Lskus:'001032', 'Base Data'] = stet;

#Gifting Bundles Input SKU 210142 
[{'Price Factor', 'Elasticity Factor'}, Lskus:'210142', 'Base Data'] = stet;

#Gift Certificates Input SKU 800250 
[{'Price Factor', 'Elasticity Factor'}, Lskus:'800250', 'Base Data'] = stet;

#Party Trays Input SKU 180734 
[{'Price Factor', 'Elasticity Factor'}, Lskus:'180734', 'Base Data'] = stet;


#-----------------------------------------------------------------------------------------------------------------------
# Make all other SKUs equal to the input SKU
#-----------------------------------------------------------------------------------------------------------------------

['Price Factor', 'Base Data'] = N: IF( ['Base Gross'] = 0, 0, DB('Forecasting', !YEAR, !Plan_Week, !Category, !LOCATIONS, !Lchannel, ATTRS( 'Lskus', !Lskus, 'Forecast Product' ), 'Base Data', 'Price Factor'));
                                                C: 0;

['Elasticity Factor', 'Base Data'] = N: IF( ['Base Gross'] = 0, 0, DB('Forecasting', !YEAR, !Plan_Week, !Category, !LOCATIONS, !Lchannel, ATTRS( 'Lskus', !Lskus, 'Forecast Product' ), 'Base Data', 'Elasticity Factor'));
                                                      C: 0;

#====================
# Price 
#====================

 ['Base Data', Fcst_Measures:'Price'] = N: ['Base Data', Fcst_Measures:'Base Price'] * (1 + ['Base Data', Fcst_Measures:'Price Factor']);

# #TESTING
#  [Fcst_Measures:'Price', Lskus:'1'] = N: ['Base Data', Fcst_Measures:'Base Price', Lskus:'TOTAL SALES BY FAMILY GROUPS'] ;


#====================
# Elasticity 
#====================
# Check 02/13/2025: This is calculating at the channel level using the Price, Base Price and Elasticity Factor by Channel

['Base Data',Fcst_Measures:'Elasticity'] = N: IF( ['Base Data', Fcst_Measures:'Base Price'] = 0, 0, 
                                                                                                   ( ( ['Base Data', Fcst_Measures:'Price'] \ 
                                                                                                        ['Base Data', Fcst_Measures:'Base Price'] ) -1 ) * 
                                                                                                        ['Base Data', 'Elasticity Factor'] );
                                                                   C: 0;

#====================
# CurrYear IPT
#====================

['Base Data', Fcst_Measures:'CurrYear IPT', Lchannel:'100', Lskus:'1'] = N: (( ['Base Data', 'CurrYear Quantity', Lchannel:'100', Lskus:'TOTAL SALES BY FAMILY GROUPS'] ) \ 
                                                                                                 ( ['Base Data', 'CurrYear Transactions', Lchannel:'C', Lskus:'1'] ));

['Base Data', Fcst_Measures:'CurrYear IPT', Lchannel:'200', Lskus:'1'] = N: (( ['Base Data', 'CurrYear Quantity', Lchannel:'200', Lskus:'TOTAL SALES BY FAMILY GROUPS'] ) \ 
                                                                                                ( ['Base Data', 'CurrYear Transactions', Lchannel:'C', Lskus:'2'] ));

['Base Data', Fcst_Measures:'CurrYear IPT', Lchannel:'300', Lskus:'1'] = N: (( ['Base Data', 'CurrYear Quantity', Lchannel:'300', Lskus:'TOTAL SALES BY FAMILY GROUPS'] ) \ 
                                                                                                ( ['Base Data', 'CurrYear Transactions', Lchannel:'B', Lskus:'3'] ));

['Base Data', Fcst_Measures:'CurrYear IPT', Lchannel:'400', Lskus:'1'] = N: (( ['Base Data', 'CurrYear Quantity', Lchannel:'400', Lskus:'TOTAL SALES BY FAMILY GROUPS'] ) \ 
                                                                                                ( ['Base Data', 'CurrYear Transactions', Lchannel:'B', Lskus:'4'] ));


#====================
# PriorYear IPT
#====================

['Base Data', Fcst_Measures:'PriorYear IPT', Lchannel:'100', Lskus:'1'] = N: (( ['Base Data', 'PriorYear Quantity', Lskus:'TOTAL SALES BY FAMILY GROUPS EXCL DONATIONS'] ) \ 
                                                                                                                           ( ['Base Data', 'PriorYear Transactions', Lchannel:'C', Lskus:'1'] )+(['Base Data', 'PriorYear Transactions', Lchannel:'C', Lskus:'6'] ));

['Base Data', Fcst_Measures:'PriorYear IPT', Lchannel:'200', Lskus:'1'] = N: (( ['Base Data', 'PriorYear Quantity', Lskus:'TOTAL SALES BY FAMILY GROUPS EXCL DONATIONS'] ) \ 
                                                                                                                           ( ['Base Data', 'PriorYear Transactions', Lchannel:'C', Lskus:'2'] ));

['Base Data', Fcst_Measures:'PriorYear IPT', Lchannel:'300', Lskus:'1'] = N: (( ['Base Data', 'PriorYear Quantity', Lskus:'TOTAL SALES BY FAMILY GROUPS EXCL DONATIONS'] ) \ 
                                                                                                                           ( ['Base Data', 'PriorYear Transactions', Lchannel:'B', Lskus:'3'] ));

['Base Data', Fcst_Measures:'PriorYear IPT', Lchannel:'400', Lskus:'1'] = N: (( ['Base Data', 'PriorYear Quantity', Lskus:'TOTAL SALES BY FAMILY GROUPS EXCL DONATIONS'] ) \ 
                                                                                                                           ( ['Base Data', 'PriorYear Transactions', Lchannel:'B', Lskus:'4'] ));


#====================
# Transactions
#====================

#New Rules 02/13/2025: This maps the Transactions calculation by Channel using the Channel and SKU that CurrYear Transactions use in SKU_DATA (Channel C or B, SKU 1,2,3,or 4) 
#Addition to rules 05/02/25:  A new Measures called "Manual Transaction Input #" was added to the dimension. This will be a manual adjustment to the transactions, and thus was added to those calculations.

[Fcst_Measures:'Transactions', Lchannel:'C']  = N:  0;
[Fcst_Measures:'Transactions', Lchannel:'B']  = N:  0;


# Original (Restore if testing fails)
#[Fcst_Measures:'Transactions', Lchannel:'100', Lskus:'1']  = N:  ( ['CurrYear Transactions', Lchannel:'C', Lskus:'1'] ) *
 #                                                            ( 1 + ['Total Initiatives','Transaction Adjustments', Lchannel:'C', Lskus:'1'] ) + ['Manual Transaction Input #', Lchannel:'C', Lskus:'1'];

# Original (Restore if testing fails)
#[Fcst_Measures:'Transactions', Lchannel:'200', Lskus:'1']  = N:  ['CurrYear Transactions', Lchannel:'C', Lskus:'2'] *
#                                                                                     ( 1 + ['Total Initiatives','Transaction Adjustments', Lchannel:'C', Lskus:'2'] ) + ['Manual Transaction Input #', Lchannel:'C', Lskus:'2'];                

# Original (Restore if testing fails)
# [Fcst_Measures:'Transactions', Lchannel:'300', Lskus:'1']  = N:  ['CurrYear Transactions', Lchannel:'B', Lskus:'3'] *
#                                                              ( 1 + ['Total Initiatives','Transaction Adjustments', Lchannel:'B', Lskus:'3'] ) + ['Manual Transaction Input #', Lchannel:'B', Lskus:'3'];

# Original (Restore if testing fails)
# [Fcst_Measures:'Transactions', Lchannel:'400', Lskus:'1']  = N:  ['CurrYear Transactions', Lchannel:'B', Lskus:'4'] *
#                                                              ( 1 + ['Total Initiatives','Transaction Adjustments', Lchannel:'B', Lskus:'4'] ) + ['Manual Transaction Input #', Lchannel:'B', Lskus:'4'];

#TESTING - Channel C, Lskus 1 => Channel 100, Lskus 1
[Fcst_Measures:'Transactions', Lchannel:'100', Lskus:'1', LRP_Initiatives:'Base Data'] = N: ( ['CurrYear Transactions','Base Data',Lchannel:'C', Lskus:'1'] ) ;

[Fcst_Measures:'Transactions', Lchannel:'100', Lskus:'1'] = N: ( ['CurrYear Transactions','Base Data',Lchannel:'C', Lskus:'1'] ) *
                                                                                                    ( ['Transaction Adjustments', Lchannel:'C', Lskus:'1'] ) + ['Manual Transaction Input #', Lchannel:'C', Lskus:'1'];

#TESTING - Channel C, Lskus 2 => Channel 200, Lskus 1
[Fcst_Measures:'Transactions', Lchannel:'200', Lskus:'1', LRP_Initiatives:'Base Data'] = N: ( ['CurrYear Transactions','Base Data',Lchannel:'C', Lskus:'2'] ) ;

[Fcst_Measures:'Transactions', Lchannel:'200', Lskus:'1'] = N: ( ['CurrYear Transactions','Base Data',Lchannel:'C', Lskus:'2'] ) *
                                                                                                    ( ['Transaction Adjustments', Lchannel:'C', Lskus:'2'] ) + ['Manual Transaction Input #', Lchannel:'C', Lskus:'2'];

#TESTING - Channel B, Lskus 3 => Channel 300, Lskus 1
[Fcst_Measures:'Transactions', Lchannel:'300', Lskus:'1', LRP_Initiatives:'Base Data'] = N: ( ['CurrYear Transactions','Base Data',Lchannel:'B', Lskus:'3'] ) ;

[Fcst_Measures:'Transactions', Lchannel:'300', Lskus:'1'] = N: ( ['CurrYear Transactions','Base Data',Lchannel:'B', Lskus:'3'] ) *
                                                                                                    ( ['Transaction Adjustments', Lchannel:'B', Lskus:'3'] ) + ['Manual Transaction Input #', Lchannel:'B', Lskus:'3'];

#TESTING - Channel B, Lskus 4 => Channel 400, Lskus 1
[Fcst_Measures:'Transactions', Lchannel:'400', Lskus:'1', LRP_Initiatives:'Base Data'] = N: ( ['CurrYear Transactions','Base Data',Lchannel:'B', Lskus:'4'] ) ;

[Fcst_Measures:'Transactions', Lchannel:'400', Lskus:'1'] = N: ( ['CurrYear Transactions','Base Data',Lchannel:'B', Lskus:'4'] ) *
                                                                                                    ( ['Transaction Adjustments', Lchannel:'B', Lskus:'4'] ) + ['Manual Transaction Input #', Lchannel:'B', Lskus:'4'];


#====================
# Base Quantity
#====================

# ['Base Data', Fcst_Measures:'Base Quantity', Lskus:'1'] = N: ['Base Data', Fcst_Measures:'Transactions', Lskus:'1'] *
#                                                                                                  ['Total Initiatives', Fcst_Measures:'CurrYear IPT', Lskus:'1'] ;

#TESTING
# [Fcst_Measures:'Base Quantity', Lskus:'1'] = N: [Fcst_Measures:'Transactions', Lskus:'1'] *
#                                                                              ['Total Initiatives', Fcst_Measures:'CurrYear IPT', Lskus:'1'] ;

['Base Data', Fcst_Measures:'Base Quantity', Lskus:'1'] = N: ['Total Initiatives', Fcst_Measures:'Transactions', Lskus:'1'] *
                                                                                                ['Total Initiatives', Fcst_Measures:'CurrYear IPT', Lskus:'1'] ;

#====================
# Base Quantity Mix
#====================

['Base Data', Fcst_Measures:'Base Quantity Mix'] =N:  ['Base Data', Fcst_Measures:'CurrYear Quantity'] \
                                                                                         ['Base Data', Fcst_Measures:'CurrYearQuantity', Lskus:'TOTAL SALES BY FAMILY GROUPS'];



#====================
# Base SKU Quantity
#====================

 ['Base Data', Fcst_Measures:'Base SKU Quantity'] =N: ['Base Data', Fcst_Measures:'Base Quantity', Lskus:'1'] *
                                                                                          ['Base Data', Fcst_Measures:'Base Quantity Mix'] ;
#TESTING
 # [Fcst_Measures:'Base SKU Quantity'] =N: [Fcst_Measures:'Base Quantity', Lskus:'1'] ;


#====================
# SKU Quantity
#====================

#Addition to rules 05/02/25:  A new Measures called "Manual Quantity Input #" was added to the dimension. This will be a manual adjustment to the SKU Quantity, and thus was added to those calculations.

['Base Data', Fcst_Measures:'SKU Quantity'] = N: ( ['Base Data', Fcst_Measures:'Base SKU Quantity'] * ( 1 + ['Base Data', Fcst_Measures:'Elasticity'] ) ) + ['Base Data', 'Manual Quantity Input #'];

#TESTING
# [Fcst_Measures:'SKU Quantity'] = N:  [Fcst_Measures:'Base SKU Quantity'] ;


#====================
# Gross
#====================

['Base Data', Fcst_Measures:'Gross'] = N: ['Base Data', Fcst_Measures:'SKU Quantity'] *
                                                                    ['Base Data', Fcst_Measures:'Price'] ;       

# 06/12/2025 - Possible Rule Change: If the Base Gross is not empty and the SKU Quantity and Price are empty, then make gross equal to the base gross.




#TESTING
# [Fcst_Measures:'Gross'] = N: [Fcst_Measures:'SKU Quantity'] *
#                                                 ['Base Data', Fcst_Measures:'Price'] ;       

# [Fcst_Measures:'Gross'] = N: [Fcst_Measures:'SKU Quantity'] *
#                                                 [Fcst_Measures:'Price'] ;       


#====================
# Prior Year Discount %
#====================

['Base Data', Fcst_Measures:'PriorYear Discount %'] = N: ['Base Data', Fcst_Measures:'CurrYear Discount'] \
                                                                                             ['Base Data', Fcst_Measures:'Base Gross'] ;

#====================
# Discount
#====================

['Base Data', Fcst_Measures:'Discount'] = N: ['Total Initiatives', Fcst_Measures:'CurrYear Discount %'] *
                                                                         ['Base Data', Fcst_Measures:'Gross'] ;

#====================
# Prior Year Discount Promo %
#====================

['Base Data', Fcst_Measures:'PriorYear Discount Promo %'] = N: ['Base Data', Fcst_Measures:'CurrYear Discount Promo'] \
                                                                                                         ['Base Data', Fcst_Measures:'Base Gross'] ;

#====================
# Discount Promo
#====================

['Base Data', Fcst_Measures:'Discount Promo'] = N: ['Total Initiatives', Fcst_Measures:'CurrYear Discount Promo %'] *
                                                                                     ['Base Data', Fcst_Measures:'Gross'] ;

#====================
# Usage Qty %
#====================

['Base Data', Fcst_Measures:'Usage Qty %'] = N: ['Base Data', Fcst_Measures:'CurrYear Usage Qty'] \ 
                                                                                ['Base Data', Fcst_Measures:'Total Quantity'];
                                                                            

#====================
# Usage Quantity
#====================
                                                                                    
['Base Data', Fcst_Measures:'Usage Quantity'] =  N: IF( ['Base Data', Fcst_Measures:'CurrYear Usage Qty'] > 0 & ['Base Data', Fcst_Measures:'SKU Quantity'] = 0, 
                                                                                          ['Base Data', Fcst_Measures:'CurrYear Usage Qty'], 
                                                                                          ['Base Data', Fcst_Measures:'Usage Qty %'] * 
                                                                                          ['Base Data', Fcst_Measures:'SKU Quantity'] \ 
                                                                                          ( 1 - ['Base Data', Fcst_Measures:'Usage Qty %'] ) );


#=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~==~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~#
#                                                                                                                     END OF RULES - BEGINNING OF FEEDERS                                                                                                                              #
#=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~==~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~=~#

FEEDERS;

#====================
# Base Price Feeders
#====================

# Base Price Feeders
['Base Gross'] => ['Base Price'] ;
['Curr Year Quantity'] => ['Base Price'] ;


#====================
# Price Feeders
#====================

  ['Base Price'] => ['Price Factor'];
  

#====================
# Elasticity 
#====================

['Base Data', Fcst_Measures:'Price'] => ['Base Data', Fcst_Measures:'Elasticity'];
['Base Data', Fcst_Measures:'Base Price'] => ['Base Data', Fcst_Measures:'Elasticity'];
['Base Data', Fcst_Measures:'Elasticity Factor'] => ['Base Data', Fcst_Measures:'Elasticity'];


#====================
# CurrYear IPT
#====================

['Base Data', 'CurrYear Quantity', Lskus:'TOTAL SALES BY FAMILY GROUPS EXCL DONATIONS'] => ['Base Data', Fcst_Measures:'CurrYear IPT', Lchannel:'100', Lskus:'1'];
['Base Data', 'CurrYear Transactions', Lchannel:'C', Lskus:'1'] => ['Base Data', Fcst_Measures:'CurrYear IPT', Lchannel:'100', Lskus:'1'];
['Base Data', 'CurrYear Transactions', Lchannel:'C', Lskus:'6'] => ['Base Data', Fcst_Measures:'CurrYear IPT', Lchannel:'100', Lskus:'1'];

['Base Data', 'CurrYear Quantity', Lskus:'TOTAL SALES BY FAMILY GROUPS EXCL DONATIONS'] => ['Base Data', Fcst_Measures:'CurrYear IPT', Lchannel:'200', Lskus:'1'];  
['Base Data', 'CurrYear Transactions', Lchannel:'C', Lskus:'2'] => ['Base Data', Fcst_Measures:'CurrYear IPT', Lchannel:'200', Lskus:'1'];  

['Base Data', 'CurrYear Quantity', Lskus:'TOTAL SALES BY FAMILY GROUPS EXCL DONATIONS'] => ['Base Data', Fcst_Measures:'CurrYear IPT', Lchannel:'300', Lskus:'1'];  
['Base Data', 'CurrYear Transactions', Lchannel:'B', Lskus:'3'] => ['Base Data', Fcst_Measures:'CurrYear IPT', Lchannel:'300', Lskus:'1'];  

['Base Data', 'CurrYear Quantity', Lskus:'TOTAL SALES BY FAMILY GROUPS EXCL DONATIONS'] => ['Base Data', Fcst_Measures:'CurrYear IPT', Lchannel:'400', Lskus:'1'];  
['Base Data', 'CurrYear Transactions', Lchannel:'B', Lskus:'4'] => ['Base Data', Fcst_Measures:'CurrYear IPT', Lchannel:'400', Lskus:'1'];  

  
  
#====================
# PriorYear IPT
#====================

['Base Data', 'PriorYear Quantity', Lskus:'TOTAL SALES BY FAMILY GROUPS EXCL DONATIONS'] => ['Base Data', Fcst_Measures:'PriorYear IPT', Lchannel:'100', Lskus:'1'];
['Base Data', 'PriorYear Transactions', Lchannel:'C', Lskus:'1'] => ['Base Data', Fcst_Measures:'PriorYear IPT', Lchannel:'100', Lskus:'1'];
['Base Data', 'PriorYear Transactions', Lchannel:'C', Lskus:'6'] => ['Base Data', Fcst_Measures:'PriorYear IPT', Lchannel:'100', Lskus:'1'];

['Base Data', 'PriorYear Quantity', Lskus:'TOTAL SALES BY FAMILY GROUPS EXCL DONATIONS'] => ['Base Data', Fcst_Measures:'PriorYear IPT', Lchannel:'200', Lskus:'1'];  
['Base Data', 'PriorYear Transactions', Lchannel:'C', Lskus:'2'] => ['Base Data', Fcst_Measures:'PriorYear IPT', Lchannel:'200', Lskus:'1'];  

['Base Data', 'PriorYear Quantity', Lskus:'TOTAL SALES BY FAMILY GROUPS EXCL DONATIONS'] => ['Base Data', Fcst_Measures:'PriorYear IPT', Lchannel:'300', Lskus:'1'];  
['Base Data', 'PriorYear Transactions', Lchannel:'B', Lskus:'3'] => ['Base Data', Fcst_Measures:'PriorYear IPT', Lchannel:'300', Lskus:'1'];  

['Base Data', 'PriorYear Quantity', Lskus:'TOTAL SALES BY FAMILY GROUPS EXCL DONATIONS'] => ['Base Data', Fcst_Measures:'PriorYear IPT', Lchannel:'400', Lskus:'1'];  
['Base Data', 'PriorYear Transactions', Lchannel:'B', Lskus:'4'] => ['Base Data', Fcst_Measures:'PriorYear IPT', Lchannel:'400', Lskus:'1'];  

  
  
#====================
# Transactions
#====================

['Base Data','CurrYear Transactions', Lchannel:'C', Lskus:'1'] => ['Transactions', Lchannel:'100', Lskus:'1'] ;  
  
['Base Data','CurrYear Transactions', Lchannel:'C', Lskus:'6'] => ['Transactions', Lchannel:'100', Lskus:'1'] ;  
['Total Initiatives','Transaction Adjustments', Lchannel:'C', Lskus:'1'] => ['Transactions', Lchannel:'100', Lskus:'1'] ;  
['Total Initiatives', 'Manual Transaction Input #', Lchannel:'C', Lskus:'1'] => ['Transactions', Lchannel:'100', Lskus:'1'] ;

['Base Data', 'CurrYear Transactions', Lchannel:'C', Lskus:'2'] => ['Transactions', Lchannel:'200', Lskus:'1'] ;  
['Total Initiatives','Transaction Adjustments', Lchannel:'C', Lskus:'2'] => ['Transactions', Lchannel:'200', Lskus:'1'] ;  

['Base Data', 'CurrYear Transactions', Lchannel:'B', Lskus:'3'] => ['Transactions', Lchannel:'300', Lskus:'1'] ;  
['Total Initiatives','Transaction Adjustments', Lchannel:'B', Lskus:'3'] => ['Transactions', Lchannel:'300', Lskus:'1'] ;  

['Base Data', 'CurrYear Transactions', Lchannel:'B', Lskus:'4'] => ['Transactions', Lchannel:'400', Lskus:'1'] ;  
['Total Initiatives','Transaction Adjustments', Lchannel:'B', Lskus:'4'] => ['Transactions', Lchannel:'400', Lskus:'1'] ;  




#====================
# Base Quantity
#====================

[Fcst_Measures:'Transactions', Lchannel:'Consumer', Lskus:'Consumer Retail'] => [Fcst_Measures:'Base Quantity', Lskus:'Consumer Retail'] ;
[Fcst_Measures:'Transactions', Lchannel:'100', Lskus:'1'] => [Fcst_Measures:'Base Quantity', Lskus:'Consumer Retail'] ;
[Fcst_Measures:'CurrYear IPT', Lskus:'Consumer Retail'] => [Fcst_Measures:'Base Quantity', Lskus:'Consumer Retail'] ;

['Total Initiatives', Fcst_Measures:'Transactions', Lchannel:'Consumer', Lskus:'Consumer Retail'] => [Fcst_Measures:'Base Quantity', Lskus:'Consumer Retail'] ;
 ['Total Initiatives', Fcst_Measures:'Transactions', Lchannel:'100', Lskus:'1'] => [Fcst_Measures:'Base Quantity', Lskus:'Consumer Retail'] ;
['Total Initiatives', Fcst_Measures:'CurrYear IPT', Lskus:'Consumer Retail'] => [Fcst_Measures:'Base Quantity', Lskus:'Consumer Retail'] ;
  
