#                                                                                                     ( ['Transaction Adjustments', Lchannel:'C', Lskus:'1'] );


#====================
# Base Quantity Mix
#====================

['Base Data', Fcst_Measures:'CurrYear Quantity'] => ['Base Data', Fcst_Measures:'Base Quantity Mix'] ;

  
#====================
# Base SKU Quantity
#====================

# ['Base Data', Fcst_Measures:'Base Quantity Mix'] => ['Base Data', Fcst_Measures:'Base SKU Quantity'] ;
# ['Base Data', Fcst_Measures:'Base Quantity', Lskus:'Consumer Retail'] => ['Base Data', Fcst_Measures:'Base SKU Quantity'] ;

['Base Data', Fcst_Measures:'Base Quantity Mix'] => ['Base Data', Fcst_Measures:'Base SKU Quantity'] ;
[Fcst_Measures:'Base Quantity', Lskus:'Consumer Retail'] => [Fcst_Measures:'Base SKU Quantity'] ;


#====================
# SKU Quantity
