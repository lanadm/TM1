{
	"@type":"MDXView",
	"Name":"D2C Sessions Conversion Rate and Web Orders",
	"MDX@Code.link":"D2C Sessions Conversion Rate and Web Orders.mdx",
	"Meta": {
		"Aliases": {
			"[Lskus].[Lskus]": "Name",
			"[WEEK].[WEEK]": "MEMBER_NAME",
			"[LOCATIONS].[LOCATIONS]": "Name"
		},
		"ExpandAboves": {
			"[YEAR].[YEAR]": false,
			"[Lskus].[Lskus]": false,
			"[CATEGORY].[CATEGORY]": false,
			"[Lchannel].[Lchannel]": false,
			"[WEEK].[WEEK]": false,
			"[Lstat].[Lstat]": false,
			"[LOCATIONS].[LOCATIONS]": false
		},
		"ContextSets": {
			"[YEAR].[YEAR]": {
				"SubsetName": "Default",
				"IsPublic": true
			},
			"[Lskus].[Lskus]": {
				"Expression": "{[Lskus].[Lskus].[SMG]}"
			},
			"[CATEGORY].[CATEGORY]": {
				"Expression": "{TM1SubsetToSet([CATEGORY].[CATEGORY],\"Default\",\"public\")}"
			},
			"[Lchannel].[Lchannel]": {
				"Expression": "{[Lchannel].[Lchannel].[ALL CHANNELS], [Lchannel].[Lchannel].[CONSUMER RETAIL], [Lchannel].[Lchannel].[100], [Lchannel].[Lchannel].[101], [Lchannel].[Lchannel].[102], [Lchannel].[Lchannel].[103], [Lchannel].[Lchannel].[600], [Lchannel].[Lchannel].[CONSUMER LUNCH], [Lchannel].[Lchannel].[B2B GIFTING], [Lchannel].[Lchannel].[B2B CATERING]}"
			},
			"[LOCATIONS].[LOCATIONS]": {
				"Expression": "{[LOCATIONS].[LOCATIONS].[SMG_TOTAL], [LOCATIONS].[LOCATIONS].[SMG_FRANCHISE], [LOCATIONS].[LOCATIONS].[SMG_RETAIL], [LOCATIONS].[LOCATIONS].[SMG_D2C]}"
			}
		}
	}
}