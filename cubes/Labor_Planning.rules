#----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
# Calculations
#----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------


#     Calculation Sandwich Portion Pounds as Sandwiches multiplied by Sandwich Portion Weight.
['Sandwich Portion Pounds'] = N: ['Sandwiches'] * ['Sandwich Portion Weight'];

#     Calculation Catering Portion Pounds as Total Catering Portions multiplied by Catering Portion Weight.
['Catering Portion Pounds'] = N: ['Total Catering Portions'] * ['Catering Portion Weight'];

#     Calculation Total Ham Weight as (Total Portion Pounds * Percent Ham) / Ham Yield
['Portions: Total Ham Weight'] = N:( ['Total Portion Pounds'] * ['Portions: Percent Ham'] ) \ ['Portions: Ham Yield'] ;

#     Calculation Half Hams to Glaze as (Total Ham Weight / Half Ham Avg Weight
['Portions: Half Hams to Glaze'] = N: ['Portions: Total Ham Weight'] \ ['Half Ham Avg Weight'] ;

#     Calculation Total Turkey Weight as (1 - Ham Yield) * Total Portion Pounds
['Portions: Total Turkey Weight'] = N: ( 1 - ['Portions: Percent Ham'] ) * ['Total Portion Pounds'] ;

#     Calculation Turkey Breast to Glaze as Total Turkey Weight / Turkey Avg Weight
['Portions:Turkey Breast to Glaze'] = N: ['Portions: Total Turkey Weight'] \ ['Turkey Avg Weight'] ;

#     Calculation Ham Portion as Total Portions * Portions: Percent Ham
['Ham Portion'] = N:['Total Portions'] * ['Portions: Percent Ham'] ;

#     Calculation Hours for Ham Portioning as Ham Portion * Ham Portion Hours Each
['Hours for Ham Portioning'] = N:['Ham Portion'] * ['Ham Portion Hours Each'] ;

#     Calculation Hours for Turkey Portioning as Turkey Portion * Turkey Portion Hours Each
['Hours for Turkey Portioning'] = N:['Turkey Portion'] * ['Turkey Portion Hours Each'] ;

#     Calculation Slices: Ham Quantity as By-the-Slice * Slices: Ham Percent
['Slices: Ham Quantity'] = N: ['By-the-Slice'] * ['Slices: Ham Percent'] ;

#     Calculation Slices: Ham Weight Needed as Ham Quantity / Slices Avg Weight
['Slices: Ham Weight Needed'] = N: ['Slices: Ham Quantity'] \ ['Slices: Avg Weight'] ;

#     Calculation Slices: Half Ham Weight as Slices: Ham Weight Needed / Slices: Ham Yield
['Slices: Half Ham Weight'] = N: ['Slices: Ham Weight Needed'] \ ['Slices: Ham Yield'] ;

#     Calculation Slices: Half Hams to Glaze as Slices: Half Ham Weight / Half Ham Avg Weight
['Slices: Half Hams to Glaze'] = N: ['Slices: Half Ham Weight'] \ ['Half Ham Avg Weight'] ;

#     Calculation Slices: Turkey Weight Needed as Slices: Avg Weight multiplied by Turkey Quantity
['Slices: Turkey Weight Needed'] = N: ['Slices: Avg Weight'] * ['Turkey Quantity'] ;

#     Calculation Slices: Turkey Breasts to Glaze as Slices: Turkey Weight Needed / Turkey Avg Weight
['Slices: Turkey Breasts to Glaze'] = N: ['Slices: Turkey Weight Needed'] \ ['Turkey Avg Weight'];

#     Calculation Slices: Ham Slicing Hours as Slices: Ham Quantity * Slices: Ham Slicing Hours Each
['Slices: Ham Slicing Hours'] = N: ['Slices: Ham Quantity'] * ['Slices: Ham Slicing Hours Each'] ;

#     Calculation Slices: Turkey Slicing Hours as Turkey Quantity * Slices: Turkey Slicing Hours Each
['Slices: Turkey Slicing Hours'] = N: ['Turkey Quantity'] * ['Slices: Turkey Slicing Hours Each'] ;

#     Calculation Production: Half Ham Hours as Production: Total Half Ham multiplied by Production: Half Ham Hours Each
['Production: Half Ham Hours'] = N: ['Production: Total Half Ham'] * ['Production: Half Ham Hours Each'] ;

#     Calculation Production: Quarter Ham Hours as Quarter Ham multiplied by Production: Quarter Ham Hours Each
['Production: Quarter Ham Hours'] = N: ['Quarter Ham'] * ['Production: Quarter Ham Hours Each'] ;

#     Calculation Production: Quarter Hams to Cut as Quarter Ham multiplied by Production: Quarter ham Cutting Percentage
['Production: Quarter Hams to Cut'] = N: ['Quarter Ham'] * ['Production: Quarter Ham Cutting Percentage'] ;

#     Calculation Production: Quarter Ham Cutting Hours as Production: Quarter hams to Cut * Production: Quarter Ham Cutting Hours Each
['Production: Quarter Ham Cutting Hours'] = N: ['Production: Quarter Hams to Cut'] * ['Production: Quarter Ham Cutting Hours Each'] ;

#     Calculation Production: Boneless Ham Hours as Boneless Ham * Production: Boneless Ham Hours Each
['Production: Boneless Ham Hours'] = N: ['Boneless Ham'] * ['Production: Boneless Ham Hours Each'] ;

#     Calculation Production: Turkey Breast Hours as Production: Total Turkey Breast * Production: Turkey Breast Hours Each
['Production: Turkey Breast Hours'] = N: ['Production: Total Turkey Breast'] * ['Production: Turkey Breast Hours Each'] ;

#     Calculation Transactions: Retail Hours as Retail Transactions * Transactions: Retail Hours
['Transactions: Retail Hours'] = N: ['Retail Transactions'] * ['Transactions: Retail Hours Per Transaction'] ;

#     Calculation Transactions: Lunch Hours as Lunch Transactions multiplied by Transactions: Lunch Hours per Transaction
['Transactions: Lunch Hours'] = N: ['Lunch Transactions'] * ['Transactions: Lunch Hours Per Transaction'] ;

#     Calculation Transactions: Catering Hours as Catering Transactions multiplied by Transactions: Catering Hours per Transaction
['Transactions: Catering Hours'] = N: ['Catering Transactions'] * ['Transactions: Catering Hours Per Transaction'] ;

#     Calculation Lunch: Production Hours as Lunch Total Quantity * Lunch: Item Build plus Lunch Total Quantity * Lunch Prep Time per Item
['Lunch: Production Hours'] = N: ( ['Lunch Total Quantity'] * ['Lunch: Item Build'] ) + ( ['Lunch Total Quantity'] * ['Lunch: Prep Time Per Item'] ) ;

#     Calculation Gifting: Gifting Production Hours as Gifting Total Quantity * Gifting: Gifting Hours Per Item
['Gifting: Gifting Production Hours'] = N: ['Gifting Total Quantity'] * ['Gifting: Gifting Hours Per Item'] ;

#     Calculation Catering: Catering Hours as Catering Total Quantity * Catering: Catering Hours Per Item
['Catering: Catering Hours'] = N: ['Catering Total Quantity'] * ['Catering: Catering Hours Per Item'] ;

#     Calculation PY Avg Wage as Hourly Wgs - Regular / Regular Hrs
['PY Avg Wage'] = N: ['Hourly Wgs - Regular'] \ ['Regular Hrs'] ;

#     Calculation Total Labor Dollars as Total Labor Hours * Avg Wage
['Total Labor Dollars'] = N: ['Total Labor Hours'] * ['Avg Wage'] ;

#     Calculation Greater of Activity or Minimum Hours as the larger of Minimum Staffed Hours or Activited HOurs
['Greater of Activity or Minimum Hours'] = N: IF( ['Activitied Hours'] > ['Minimum Staffed Hours'], ['Activitied Hours'], ['Minimum Staffed Hours'] );



