# Minimum Staffed Hours:

#     Allow Input to Minimum Staffed Hours 52116800 & 52116700.
['Minimum Staffed Hours', {'52116800', '52116700'}] = stet;

#    Propagate Minimum Staffed Hours for 52116800 to all Express Stores, and 52116700 to all CompanyOwned Stores.
['Minimum Staffed Hours'] =
		IF( DB( '}ElementAttributes_LOCATIONS', !LOCATIONS, 'Plan_StoreType' ) @= 'Express', ['Minimum Staffed Hours', '52116800'],
		IF( DB( '}ElementAttributes_LOCATIONS', !LOCATIONS, 'Plan_StoreType' ) @= 'CompanyOwned', ['Minimum Staffed Hours', '52116700'],
		stet ));



