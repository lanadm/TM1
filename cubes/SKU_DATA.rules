['QoIO TTD 4'] = N: DB( 'SKU_DATA', !YEAR, !CATEGORY, !LOCATIONS, !Lskus, attrs( 'WEEK', !WEEK, 'TTD' ), 'QoIO 4 * N', !Lchannel ) \ DB( 'SKU_DATA', !YEAR, !CATEGORY, !LOCATIONS, !Lskus, attrs( 'WEEK', !WEEK, 'TTD' ), 'QoIO N', !Lchannel );
['QoIO TTD 5'] = N: DB( 'SKU_DATA', !YEAR, !CATEGORY, !LOCATIONS, !Lskus, attrs( 'WEEK', !WEEK, 'TTD' ), 'QoIO 5 * N', !Lchannel ) \ DB( 'SKU_DATA', !YEAR, !CATEGORY, !LOCATIONS, !Lskus, attrs( 'WEEK', !WEEK, 'TTD' ), 'QoIO N', !Lchannel );

#---------------------------------
# VALUE Average
#---------------------------------

['VALUE 1 * N'] = N: ['VALUE 1'] * ['VALUE N'] ;
['VALUE 2 * N'] = N: ['VALUE 2'] * ['VALUE N'] ;
['VALUE 3 * N'] = N: ['VALUE 3'] * ['VALUE N'] ;
['VALUE 4 * N'] = N: ['VALUE 4'] * ['VALUE N'] ;
['VALUE 5 * N'] = N: ['VALUE 5'] * ['VALUE N'] ;

#---------------------------------
