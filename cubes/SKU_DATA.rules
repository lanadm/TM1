['VALUE YTD 5'] = N: DB( 'SKU_DATA', !YEAR, !CATEGORY, !LOCATIONS, !Lskus, attrs( 'WEEK', !WEEK, 'YTD' ), 'VALUE 5 * N', !Lchannel ) \ DB( 'SKU_DATA', !YEAR, !CATEGORY, !LOCATIONS, !Lskus, attrs( 'WEEK', !WEEK, 'YTD' ), 'VALUE N', !Lchannel );

#---------------------------------
