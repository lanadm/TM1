#---------------------------------
# Turkey Breast (Selecting LSKUS "110104 - RTB" to book the number)
#---------------------------------

#If the Location is a Franchise, do not divide by 2, as Franchise only loads to one lskus
# Actual


['Sales Pounds (Calc)', '110104', '100'] = N: ['Gross', '110104', 'ALL CHANNELS'] \ ['Ham Price per lb', '100'];

['Sales Pounds (Calc)', '110104', 'Actual', 'ALL CHANNELS'] = C: ['Sales Pounds (Calc)', '110104', 'Actual', '100'];



# Budget
#If Sales Pounds is empty for Budget, then calculate, otherwise take the amount from Sales Pounds.
#If the Location is a Franchise, do not divide by 2, as Franchise only loads to one lskus
['Sales Pounds (Calc)','110104', 'Budget'] = N: IF( DB('}ElementAttributes_LOCATIONS',!LOCATIONS,'SSS') @= 'FRANCHISE',
					IF( ['Sales Pounds', 'TURKEY BREAST', 'ALL CHANNELS', 'Budget'] =0,
					    	( ['Gross','TURKEY BREAST', 'ALL CHANNELS', 'Budget'] \ ( ['Ham Price per lb', 'TURKEY BREAST', 'Budget'] ) ),
					       	['Sales Pounds', 'Budget'] ),
					IF( ['Sales Pounds', 'TURKEY BREAST', 'ALL CHANNELS', 'Budget'] =0,
						( ['Gross','TURKEY BREAST', 'ALL CHANNELS', 'Budget'] \ ( ['Ham Price per lb', 'TURKEY BREAST', 'Budget'] / 2 ) ),
						['Sales Pounds', 'Budget'] ));

['Average Sales Weight', '110104', '100'] = 	N: ['Sales Pounds (Calc)', '110104', '100'] \ ['Quantity', '110104', '100'] ;
					C: ['Sales Pounds (Calc)', '110104', '100'] \ ['Quantity', '110104', '100'] ;

['Average Sales Weight', '110104', 'ALL CHANNELS'] = C: ['Average Sales Weight', '110104', '100'];


# The rollups are made to equal the calculation above.

['Average Sales Weight', 'ROASTED TKY BREAST (PRODUCT)', '100'] = C: ['Average Sales Weight', '110104', '100'] ;
['Average Sales Weight', 'ROASTED TKY BREAST (PRODUCT)', 'ALL CHANNELS'] = C: ['Average Sales Weight', '110104', '100'] ;

['Average Sales Weight', 'ROASTED TURKEY BREAST', '100'] = C: ['Average Sales Weight','110104', '100'] ;
['Average Sales Weight', 'ROASTED TURKEY BREAST', 'ALL CHANNELS'] = C: ['Average Sales Weight','110104', '100'] ;

['Average Sales Weight', 'INDIVIDUAL TURKEY BREAST', '100'] = C: ['Average Sales Weight','110104', '100'] ;
['Average Sales Weight', 'INDIVIDUAL TURKEY BREAST', 'ALL CHANNELS'] = C: ['Average Sales Weight','110104', '100'] ;

['Average Sales Weight', 'TURKEY BREAST', '100'] = C: ['Average Sales Weight','110104', '100'] ;
['Average Sales Weight', 'TURKEY BREAST', 'ALL CHANNELS'] = C: ['Average Sales Weight','110104', '100'] ;



#========================================================
# SMG YTD, PTD & TTD Rollups
#========================================================

#---------------------------------
# OSAT Average
#---------------------------------

['OSAT 1 * N'] = N: ['OSAT 1'] * ['OSAT N'] ;
['OSAT 2 * N'] = N: ['OSAT 2'] * ['OSAT N'] ;
['OSAT 3 * N'] = N: ['OSAT 3'] * ['OSAT N'] ;
['OSAT 4 * N'] = N: ['OSAT 4'] * ['OSAT N'] ;
['OSAT 5 * N'] = N: ['OSAT 5'] * ['OSAT N'] ;

#---------------------------------
# OSAT YTD
#---------------------------------

['OSAT YTD 1'] = N: DB( 'SKU_DATA', !YEAR, !CATEGORY, !LOCATIONS, !Lskus, attrs( 'WEEK', !WEEK, 'YTD' ), 'OSAT 1 * N', !Lchannel ) \ DB( 'SKU_DATA', !YEAR, !CATEGORY, !LOCATIONS, !Lskus, attrs( 'WEEK', !WEEK, 'YTD' ), 'OSAT N', !Lchannel );
['OSAT YTD 2'] = N: DB( 'SKU_DATA', !YEAR, !CATEGORY, !LOCATIONS, !Lskus, attrs( 'WEEK', !WEEK, 'YTD' ), 'OSAT 2 * N', !Lchannel ) \ DB( 'SKU_DATA', !YEAR, !CATEGORY, !LOCATIONS, !Lskus, attrs( 'WEEK', !WEEK, 'YTD' ), 'OSAT N', !Lchannel );
['OSAT YTD 3'] = N: DB( 'SKU_DATA', !YEAR, !CATEGORY, !LOCATIONS, !Lskus, attrs( 'WEEK', !WEEK, 'YTD' ), 'OSAT 3 * N', !Lchannel ) \ DB( 'SKU_DATA', !YEAR, !CATEGORY, !LOCATIONS, !Lskus, attrs( 'WEEK', !WEEK, 'YTD' ), 'OSAT N', !Lchannel );
['OSAT YTD 4'] = N: DB( 'SKU_DATA', !YEAR, !CATEGORY, !LOCATIONS, !Lskus, attrs( 'WEEK', !WEEK, 'YTD' ), 'OSAT 4 * N', !Lchannel ) \ DB( 'SKU_DATA', !YEAR, !CATEGORY, !LOCATIONS, !Lskus, attrs( 'WEEK', !WEEK, 'YTD' ), 'OSAT N', !Lchannel );
['OSAT YTD 5'] = N: DB( 'SKU_DATA', !YEAR, !CATEGORY, !LOCATIONS, !Lskus, attrs( 'WEEK', !WEEK, 'YTD' ), 'OSAT 5 * N', !Lchannel ) \ DB( 'SKU_DATA', !YEAR, !CATEGORY, !LOCATIONS, !Lskus, attrs( 'WEEK', !WEEK, 'YTD' ), 'OSAT N', !Lchannel );

#---------------------------------
# OSAT PTD
#---------------------------------

['OSAT PTD 1'] = N: DB( 'SKU_DATA', !YEAR, !CATEGORY, !LOCATIONS, !Lskus, attrs( 'WEEK', !WEEK, 'PTD' ), 'OSAT 1 * N', !Lchannel ) \ DB( 'SKU_DATA', !YEAR, !CATEGORY, !LOCATIONS, !Lskus, attrs( 'WEEK', !WEEK, 'PTD' ), 'OSAT N', !Lchannel );
['OSAT PTD 2'] = N: DB( 'SKU_DATA', !YEAR, !CATEGORY, !LOCATIONS, !Lskus, attrs( 'WEEK', !WEEK, 'PTD' ), 'OSAT 2 * N', !Lchannel ) \ DB( 'SKU_DATA', !YEAR, !CATEGORY, !LOCATIONS, !Lskus, attrs( 'WEEK', !WEEK, 'PTD' ), 'OSAT N', !Lchannel );
['OSAT PTD 3'] = N: DB( 'SKU_DATA', !YEAR, !CATEGORY, !LOCATIONS, !Lskus, attrs( 'WEEK', !WEEK, 'PTD' ), 'OSAT 3 * N', !Lchannel ) \ DB( 'SKU_DATA', !YEAR, !CATEGORY, !LOCATIONS, !Lskus, attrs( 'WEEK', !WEEK, 'PTD' ), 'OSAT N', !Lchannel );
['OSAT PTD 4'] = N: DB( 'SKU_DATA', !YEAR, !CATEGORY, !LOCATIONS, !Lskus, attrs( 'WEEK', !WEEK, 'PTD' ), 'OSAT 4 * N', !Lchannel ) \ DB( 'SKU_DATA', !YEAR, !CATEGORY, !LOCATIONS, !Lskus, attrs( 'WEEK', !WEEK, 'PTD' ), 'OSAT N', !Lchannel );
['OSAT PTD 5'] = N: DB( 'SKU_DATA', !YEAR, !CATEGORY, !LOCATIONS, !Lskus, attrs( 'WEEK', !WEEK, 'PTD' ), 'OSAT 5 * N', !Lchannel ) \ DB( 'SKU_DATA', !YEAR, !CATEGORY, !LOCATIONS, !Lskus, attrs( 'WEEK', !WEEK, 'PTD' ), 'OSAT N', !Lchannel );

