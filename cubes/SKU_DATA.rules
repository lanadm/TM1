['VALUE TTD 1'] = N: DB( 'SKU_DATA', !YEAR, !CATEGORY, !LOCATIONS, !Lskus, attrs( 'WEEK', !WEEK, 'TTD' ), 'VALUE 1 * N', !Lchannel ) \ DB( 'SKU_DATA', !YEAR, !CATEGORY, !LOCATIONS, !Lskus, attrs( 'WEEK', !WEEK, 'TTD' ), 'VALUE N', !Lchannel );
['VALUE TTD 2'] = N: DB( 'SKU_DATA', !YEAR, !CATEGORY, !LOCATIONS, !Lskus, attrs( 'WEEK', !WEEK, 'TTD' ), 'VALUE 2 * N', !Lchannel ) \ DB( 'SKU_DATA', !YEAR, !CATEGORY, !LOCATIONS, !Lskus, attrs( 'WEEK', !WEEK, 'TTD' ), 'VALUE N', !Lchannel );
['VALUE TTD 3'] = N: DB( 'SKU_DATA', !YEAR, !CATEGORY, !LOCATIONS, !Lskus, attrs( 'WEEK', !WEEK, 'TTD' ), 'VALUE 3 * N', !Lchannel ) \ DB( 'SKU_DATA', !YEAR, !CATEGORY, !LOCATIONS, !Lskus, attrs( 'WEEK', !WEEK, 'TTD' ), 'VALUE N', !Lchannel );
['VALUE TTD 4'] = N: DB( 'SKU_DATA', !YEAR, !CATEGORY, !LOCATIONS, !Lskus, attrs( 'WEEK', !WEEK, 'TTD' ), 'VALUE 4 * N', !Lchannel ) \ DB( 'SKU_DATA', !YEAR, !CATEGORY, !LOCATIONS, !Lskus, attrs( 'WEEK', !WEEK, 'TTD' ), 'VALUE N', !Lchannel );
['VALUE TTD 5'] = N: DB( 'SKU_DATA', !YEAR, !CATEGORY, !LOCATIONS, !Lskus, attrs( 'WEEK', !WEEK, 'TTD' ), 'VALUE 5 * N', !Lchannel ) \ DB( 'SKU_DATA', !YEAR, !CATEGORY, !LOCATIONS, !Lskus, attrs( 'WEEK', !WEEK, 'TTD' ), 'VALUE N', !Lchannel );

#---------------------------------
# DOT Average
#---------------------------------

['DOT YES * N'] = N: ['DOT YES'] * ['DOT N'] ;
['DOT NO * N'] = N: ['DOT NO'] * ['DOT N'] ;

#---------------------------------
# DOT YTD
#---------------------------------

['DOT YTD YES'] = N: DB( 'SKU_DATA', !YEAR, !CATEGORY, !LOCATIONS, !Lskus, attrs( 'WEEK', !WEEK, 'YTD' ), 'DOT YES * N', !Lchannel ) \ DB( 'SKU_DATA', !YEAR, !CATEGORY, !LOCATIONS, !Lskus, attrs( 'WEEK', !WEEK, 'YTD' ), 'DOT N', !Lchannel );
['DOT YTD NO'] = N: DB( 'SKU_DATA', !YEAR, !CATEGORY, !LOCATIONS, !Lskus, attrs( 'WEEK', !WEEK, 'YTD' ), 'DOT NO * N', !Lchannel ) \ DB( 'SKU_DATA', !YEAR, !CATEGORY, !LOCATIONS, !Lskus, attrs( 'WEEK', !WEEK, 'YTD' ), 'DOT N', !Lchannel );


#---------------------------------
# DOT PTD
#---------------------------------

['DOT PTD YES'] = N: DB( 'SKU_DATA', !YEAR, !CATEGORY, !LOCATIONS, !Lskus, attrs( 'WEEK', !WEEK, 'PTD' ), 'DOT YES * N', !Lchannel ) \ DB( 'SKU_DATA', !YEAR, !CATEGORY, !LOCATIONS, !Lskus, attrs( 'WEEK', !WEEK, 'PTD' ), 'DOT N', !Lchannel );
['DOT PTD NO'] = N: DB( 'SKU_DATA', !YEAR, !CATEGORY, !LOCATIONS, !Lskus, attrs( 'WEEK', !WEEK, 'PTD' ), 'DOT NO * N', !Lchannel ) \ DB( 'SKU_DATA', !YEAR, !CATEGORY, !LOCATIONS, !Lskus, attrs( 'WEEK', !WEEK, 'PTD' ), 'DOT N', !Lchannel );


#---------------------------------
# DOT TTD
#---------------------------------

['DOT TTD YES'] = N: DB( 'SKU_DATA', !YEAR, !CATEGORY, !LOCATIONS, !Lskus, attrs( 'WEEK', !WEEK, 'TTD' ), 'DOT YES * N', !Lchannel ) \ DB( 'SKU_DATA', !YEAR, !CATEGORY, !LOCATIONS, !Lskus, attrs( 'WEEK', !WEEK, 'TTD' ), 'DOT N', !Lchannel );
['DOT TTD NO'] = N: DB( 'SKU_DATA', !YEAR, !CATEGORY, !LOCATIONS, !Lskus, attrs( 'WEEK', !WEEK, 'TTD' ), 'DOT NO * N', !Lchannel ) \ DB( 'SKU_DATA', !YEAR, !CATEGORY, !LOCATIONS, !Lskus, attrs( 'WEEK', !WEEK, 'TTD' ), 'DOT N', !Lchannel );




#---------------------------------
# IPT
#---------------------------------

[lskus:'IPT', lstat:'IPT'] = N: ['IPT Items'] \ ['IPT Transactions'] ;
	                            C: ['IPT Items'] \ ['IPT Transactions'] ;


#---------------------------------
# BOPIS IPT
#---------------------------------

['BOPIS', 'BOPIS IPT'] = N: ['BOPIS Items'] \ ['BOPIS Transactions'] ;
	                          C: ['BOPIS Items'] \ ['BOPIS Transactions'] ;

['BOPIS', 'SD BOPIS IPT'] = N: ['SD BOPIS Items'] \ ['SD BOPIS Transactions'] ;
                                               C: ['SD BOPIS Items'] \ ['SD BOPIS Transactions'] ;

#---------------------------------
# BOPAC IPT
#---------------------------------

['BOPAC', 'BOPAC IPT'] = N: ['BOPAC Items'] \ ['BOPAC Transactions'] ;
	                            C: ['BOPAC Items'] \ ['BOPAC Transactions'] ;

['BOPAC', 'SD BOPAC IPT'] = N: ['SD BOPAC Items'] \ ['SD BOPAC Transactions'] ;
                                               C: ['SD BOPAC Items'] \ ['SD BOPAC Transactions'] ;


#---------------------------------
# HAM EVAL
#---------------------------------

['Ham Evaluation'] = C: ConsolidatedAvg( 3, 'SKU_DATA', !YEAR, !CATEGORY, !LOCATIONS, 'SMG', !WEEK, 'Ham Evaluation', !Lchannel );
['Number of Hams Evaluated'] = C: ConsolidatedAvg( 3, 'SKU_DATA', !YEAR, !CATEGORY, !LOCATIONS, 'SMG', !WEEK, 'Number of Hams Evaluated', !Lchannel );


#---------------------------------
# QAD Scores
#---------------------------------

['QAD Scores'] = C: ConsolidatedAvg( 3, 'SKU_DATA', !YEAR, !CATEGORY, !LOCATIONS,!Lskus, !WEEK, 'QAD Scores', !Lchannel );


#---------------------------------
# QAD Scores
#---------------------------------

['Conversion Rate'] = 	N: ['Web Orders'] \ ['Sessions - Traffic'] ;
			C: ['Web Orders'] \ ['Sessions - Traffic'] ;


#---------------------------------
# Average Ticket
#---------------------------------

#['Average Ticket'] = ['Gross'] \ ['Selling Metrics Transactions'] ;

#========================================================
# Purchase Table Budget Propagation
#========================================================


# Allow Input to Location 52500700, Channel 100 for Standard Cost   

['Budgeted Standard', {'Budget', 'T1 Forecast', 'T2 Forecast', 'T3 Forecast'}, {'Period 1', 'Period 2', 'Period 3', 'Period 4', 'Period 5', 'Period 6', 'Period 7', 'Period 8', 'Period 9', 'Period 10', 'Period 11', 'Period 12'}] = N:
    IF( ATTRS( 'LOCATIONS', !LOCATIONS, 'PurchTbl_Include' ) @= 'Y', 
      # & ATTRS( 'Lchannel', !Lchannel, 'PurchTbl_Include' ) @= 'Y', 
          ['Budgeted Standard', '52500700'], STET);      
  
 C: 
    IF( ATTRS( 'LOCATIONS', !LOCATIONS, 'PurchTbl_Include' ) @= 'Y', 
      # & ATTRS( 'Lchannel', !Lchannel, 'PurchTbl_Include' ) @= 'Y', 
          ['Budgeted Standard', '52500700'], STET);      



#========================================================
# COGS Usage
#========================================================

['Standard Cost', 'Budget'] = IF( attrs('WEEK', !WEEK, 'COGS_PD') @<> '',
                                                   DB( 'SKU_DATA', !YEAR, 'Budget', !LOCATIONS, !Lskus, attrs('WEEK', !WEEK, 'COGS_PD'), 'Standard Cost', !Lchannel ),
                                                   CONTINUE );

# Budget
['COGS Usage', 'Budget', Lchannel:'100'] = N: IF( attrs( 'YEAR', !YEAR, 'COGS_CALC' ) @<> 'N', 
                                                        ['Quantity', 'Budget', 'ALL CHANNELS'] *
                                                        DB( 'SKU_DATA', !YEAR, 'Budget', !LOCATIONS, !Lskus, attrs('WEEK', !WEEK, 'COGS_PD'), 'Standard Cost', !Lchannel ),
                                                        STET) ;




