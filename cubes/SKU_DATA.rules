skipcheck;

#========================================================
# Ham Price per lb
#========================================================


['Ham Price per lb', 'FY 22', 'Budget', 'Wk 1 - 10/03/21'] = stet;

['Ham Price per lb', 'FY 22', 'Rev Fcst', 'Wk 1 - 10/03/21'] = stet;

['Ham Price per lb', 'FY 22', 'Forecast 6', 'Wk 1 - 10/03/21'] = stet;

['Ham Price per lb','FY 22', 'Budget'] = ['Ham Price per lb', 'FY 22', 'Budget', 'Wk 1 - 10/03/21'] ;

['Ham Price per lb','FY 22', 'Rev Fcst'] = ['Ham Price per lb', 'FY 22', 'Rev Fcst', 'Wk 1 - 10/03/21'] ;

['Ham Price per lb','FY 22', 'Forecast 6'] = ['Ham Price per lb', 'FY 22', 'Forecast 6', 'Wk 1 - 10/03/21'] ;

# ROLLUPS
['Ham Price per lb', 'Actual', 'HALF HAM (PRODUCT)'] = C: ['Ham Price per lb', 'Actual', '101200'];
['Ham Price per lb', 'Actual', 'WHOLE HAM (PRODUCT)'] = C: ['Ham Price per lb', 'Actual', '101000'];
['Ham Price per lb', 'Actual', 'INDIVIDUAL QUARTER HAM'] = C: ['Ham Price per lb', 'Actual', '100114'];
['Ham Price per lb', 'Actual', 'BONELESS HALF HAM'] = C: ['Ham Price per lb', 'Actual', '100116'];
['Ham Price per lb', 'Actual', 'BONELESS WHOLE HAM'] = C: ['Ham Price per lb', 'Actual', '100115'];

['Ham Price per lb', 'Actual', 'HALF HAM'] = C: ['Ham Price per lb', 'Actual', '101200'];
['Ham Price per lb', 'Actual', 'WHOLE HAM'] = C: ['Ham Price per lb', 'Actual', '101000'];
['Ham Price per lb', 'Actual', 'QUARTER HAM'] = C: ['Ham Price per lb', 'Actual', '100114'];



#========================================================
# SALES POUNDS
#========================================================

['Sales Pounds (Calc)', 'Actual', {'FY 93', 'FY 94', 'FY 95', 'FY 96', 'FY 97', 'FY 98', 'FY 99', 'FY 00', 'FY 01', 'FY 02', 'FY 03', 'FY 04', 'FY 05', 'FY 06', 'FY 07', 'FY 08', 'FY 09', 'FY 10', 'FY 11', 'FY 12', 'FY 13', 'FY 14', 'FY 15', 'FY 16', 'FY 17', 'FY 18', 'FY 19', 'FY 20'}] = stet;


#---------------------------------
# Half Ham (Selecting LSKUS "101200 - Half Ham" to book the number)
#---------------------------------

# Actual

['Sales Pounds (Calc)','101200','100'] = 	N: ['Gross','101200', 'ALL CHANNELS'] \ ['Ham Price per lb','100'];

['Sales Pounds (Calc)','101200', 'Actual', 'ALL CHANNELS'] = C: ['Sales Pounds (Calc)', '101200', 'Actual', '100'];


# Budget
#If Sales Pounds is empty for Budget, then calculate, otherwise take the amount from Sales Pounds.
['Sales Pounds (Calc)','101200', 'Budget'] = N: IF( ['Sales Pounds', 'HALF HAM', 'ALL CHANNELS', 'Budget'] =0,
					( ['Gross','HALF HAM', 'ALL CHANNELS', 'Budget'] \ ['Ham Price per lb', 'HALF HAM', 'Budget'] ),
					['Sales Pounds', 'Budget'] );

# Average Sales Weight Calculation

# Price is applied only to 101200, and only the Quantity in Retail (Channel 100) is use for this calculation

['Average Sales Weight', '101200', '100'] = 	N: ['Sales Pounds (Calc)', '101200', '100'] \ ['Quantity', '101200', '100'] ;
					C: ['Sales Pounds (Calc)', '101200', '100'] \ ['Quantity', '101200', '100'] ;

['Average Sales Weight', '101200', 'ALL CHANNELS'] = C: ['Average Sales Weight', '101200', '100'];


# The rollups are made to equal the calculation above.

['Average Sales Weight', 'HALF HAM (PRODUCT)', '100'] = C: ['Average Sales Weight', '101200', '100'] ;
['Average Sales Weight', 'HALF HAM (PRODUCT)', 'ALL CHANNELS'] = C: ['Average Sales Weight', '101200', '100'] ;

['Average Sales Weight', 'HALF HAM', '100'] = C: ['Average Sales Weight','101200', '100'] ;
['Average Sales Weight', 'HALF HAM', 'ALL CHANNELS'] = C: ['Average Sales Weight','101200', '100'] ;


