['VALUE PTD 1'] = N: DB( 'SKU_DATA', !YEAR, !CATEGORY, !LOCATIONS, !Lskus, attrs( 'WEEK', !WEEK, 'PTD' ), 'VALUE 1 * N', !Lchannel ) \ DB( 'SKU_DATA', !YEAR, !CATEGORY, !LOCATIONS, !Lskus, attrs( 'WEEK', !WEEK, 'PTD' ), 'VALUE N', !Lchannel );
['VALUE PTD 2'] = N: DB( 'SKU_DATA', !YEAR, !CATEGORY, !LOCATIONS, !Lskus, attrs( 'WEEK', !WEEK, 'PTD' ), 'VALUE 2 * N', !Lchannel ) \ DB( 'SKU_DATA', !YEAR, !CATEGORY, !LOCATIONS, !Lskus, attrs( 'WEEK', !WEEK, 'PTD' ), 'VALUE N', !Lchannel );
['VALUE PTD 3'] = N: DB( 'SKU_DATA', !YEAR, !CATEGORY, !LOCATIONS, !Lskus, attrs( 'WEEK', !WEEK, 'PTD' ), 'VALUE 3 * N', !Lchannel ) \ DB( 'SKU_DATA', !YEAR, !CATEGORY, !LOCATIONS, !Lskus, attrs( 'WEEK', !WEEK, 'PTD' ), 'VALUE N', !Lchannel );
['VALUE PTD 4'] = N: DB( 'SKU_DATA', !YEAR, !CATEGORY, !LOCATIONS, !Lskus, attrs( 'WEEK', !WEEK, 'PTD' ), 'VALUE 4 * N', !Lchannel ) \ DB( 'SKU_DATA', !YEAR, !CATEGORY, !LOCATIONS, !Lskus, attrs( 'WEEK', !WEEK, 'PTD' ), 'VALUE N', !Lchannel );
['VALUE PTD 5'] = N: DB( 'SKU_DATA', !YEAR, !CATEGORY, !LOCATIONS, !Lskus, attrs( 'WEEK', !WEEK, 'PTD' ), 'VALUE 5 * N', !Lchannel ) \ DB( 'SKU_DATA', !YEAR, !CATEGORY, !LOCATIONS, !Lskus, attrs( 'WEEK', !WEEK, 'PTD' ), 'VALUE N', !Lchannel );

#---------------------------------
