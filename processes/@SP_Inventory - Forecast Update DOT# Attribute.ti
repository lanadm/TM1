#region Prolog

#----------------------------
# Dimension / Attribute
#----------------------------
strDimSKU      = 'SP_SKU';
strAttrDotItem = 'DOT#';


#endregion
#region Metadata

strSKU    = TRIM(vSKU);
strDotRaw = TRIM(vDotItemNum);

# skip if SKU not in dimension
IF( DIMIX('SP_SKU', strSKU) = 0 );
    ItemSkip;
ENDIF;

# clean NBSP
p = SCAN( CHAR(160), strDotRaw );
WHILE( p > 0 );
    strDotRaw = SUBST(strDotRaw,1,p-1) | SUBST(strDotRaw,p+1,999);
    p = SCAN( CHAR(160), strDotRaw );
END;

IF( strDotRaw @<> '' );
    IF( ATTRS('SP_SKU', strSKU, 'DOT#') @<> strDotRaw );
        AttrPutS(strDotRaw, 'SP_SKU', strSKU, 'DOT#');
    ENDIF;
ELSE;
    # optional clear
    AttrPutS('', 'SP_SKU', strSKU, 'DOT#');
ENDIF;

#endregion